# /etc/sudoers.d/gains-manager
# Allows the gains-manager service user (slytovka) to control
# systemd user services for all tenant accounts without a password prompt.
#
# Install: sudo cp sudoers-gains-manager /etc/sudoers.d/gains-manager
#          sudo chmod 440 /etc/sudoers.d/gains-manager
#          sudo visudo -c -f /etc/sudoers.d/gains-manager

# Run systemctl --user commands as any tenant user
slytovka ALL=(archpoint,batteriesplus,cbcgroup,decksdirect,khov,ncs,paladin,sps,terumobct,vallen,vallenusa,zoll) NOPASSWD: /usr/bin/env

# Check PostgreSQL status
slytovka ALL=(root) NOPASSWD: /usr/bin/systemctl status postgresql
slytovka ALL=(root) NOPASSWD: /usr/bin/systemctl is-active postgresql

# Auto-discover service files across all home directories
slytovka ALL=(root) NOPASSWD: /usr/bin/find /home -path *
